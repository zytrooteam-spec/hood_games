# ========================================================
# HOOD GAMES (hoodgames.com) SYSTEM ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Database Connection (MongoDB Atlas or Local MongoDB)
# Note: Built-in resilient JSON fallback activates if MongoDB is offline during development
MONGODB_URI=mongodb+srv://zytrooteam_db_user:<db_password>@cluster0.jpohxps.mongodb.net/hood_games?retryWrites=true&w=majority&appName=Cluster0

# 2. Security & Session Secrets
JWT_SECRET=hood_games_ultra_secure_jwt_token_2026_exclusive_vip_key

# 3. Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3007
CAPACITOR_SERVER_URL=https://hoodgaming.com

# 4. Geo-Lock Configuration (Set true for dev testing)
BYPASS_GEO_LOCK=true

# 5. ADMIN CREDENTIALS (Strictly read from ENV, NEVER hardcoded!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HoodGamesAdmin@2026!
ADMIN_EMAIL=admin@hoodgames.com

# Staff Credentials
STAFF_USERNAME=staff
STAFF_PASSWORD=HoodStaff@2026!
STAFF_EMAIL=staff@hoodgames.com

# 6. SMTP Email Notification Configuration (Hostinger / Custom)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@hoodgaming.com
SMTP_PASS=your_mailbox_password_here
SMTP_FROM="Hood Gaming" <support@hoodgaming.com>

# 7. Firebase FCM Service Account (Optional for Push Notifications)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
